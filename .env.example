# Only scripts/setup.mjs creates .env.local; never commit real credentials.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://slotly:replace-with-local-password@127.0.0.1:54329/slotly
# disable is for local PostgreSQL; verify-full verifies external TLS certificates.
DATABASE_SSL=disable
BETTER_AUTH_SECRET=replace-with-random-secret
MAIL_TRANSPORT=local
# Public deployments must choose a single header overwritten by a trusted proxy.
# CLIENT_IP_HEADER=x-slotly-proxy-ip
# SMTP is opt-in and requires HTTPS APP_URL. Never commit real SMTP credentials.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com
# Shared SMTP attempt budgets across web + worker; match provider quotas.
# MAIL_MAX_PER_HOUR=100
# MAIL_MAX_PER_DAY=1000
# MAIL_RECIPIENT_MAX_PER_HOUR=20
# MAIL_RECIPIENT_MAX_PER_DAY=100
# Separate 32-byte hex key for backups; db:roles moves it to .env.operations.local.
BACKUP_ENCRYPTION_KEY=replace-with-backup-encryption-key
# Optional directory containing pg_dump and pg_restore (PostgreSQL 18).
# PG_BIN_DIR=
# db:roles provisions local runtime/migration logins; admin URLs stay in
# ignored .env.operations.local, which must never be deployed with the web app.
