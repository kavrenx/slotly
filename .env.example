# Only scripts/setup.mjs creates .env.local; never commit real credentials.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://slotly:replace-with-local-password@127.0.0.1:54329/slotly
# disable is for local PostgreSQL; verify-full verifies external TLS certificates.
DATABASE_SSL=disable
BETTER_AUTH_SECRET=replace-with-random-secret
MAIL_TRANSPORT=local
# Separate 32-byte hex key for encrypted backups; keep an offline copy.
BACKUP_ENCRYPTION_KEY=replace-with-backup-encryption-key
# Optional directory containing pg_dump and pg_restore (PostgreSQL 18).
# PG_BIN_DIR=
