{
  "name": "slotly",
  "version": "0.1.0",
  "description": "Personal booking links and shared availability, starting with a Russian-language MVP.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "env:check": "tsx scripts/check-env.ts",
    "repo:check": "node scripts/check-repository.mjs",
    "predev": "npm run env:check",
    "dev": "node scripts/run-app.mjs dev",
    "build": "next build",
    "prestart": "tsx scripts/check-env.ts --production",
    "start": "node scripts/run-app.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "mail:local": "tsx scripts/local-mail.ts",
    "notifications:work": "tsx scripts/notification-worker.ts",
    "notifications:once": "tsx scripts/notification-worker.ts --once",
    "notifications:status": "tsx scripts/notification-worker.ts --status",
    "notifications:retry": "tsx scripts/notification-worker.ts --retry-failed"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@js-temporal/polyfill": "0.5.1",
    "@next/env": "16.4.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "@zxcvbn-ts/language-ru": "4.1.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  }
}
